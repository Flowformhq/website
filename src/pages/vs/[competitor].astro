---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { COMPETITORS, type CompetitorComparison } from '../../data/comparisons';

export function getStaticPaths() {
  return COMPETITORS.map((competitor) => ({
    params: { competitor: competitor.slug },
    props: { competitor },
  }));
}

interface Props {
  competitor: CompetitorComparison;
}

const { competitor } = Astro.props;
const others = COMPETITORS.filter((item) => item.slug !== competitor.slug);
const canonical = `https://flowformhq.com/vs/${competitor.slug}/`;

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: `FlowForm vs ${competitor.name}`,
  description: competitor.summary,
  datePublished: competitor.asOfDate,
  dateModified: competitor.asOfDate,
  author: {
    '@type': 'Organization',
    name: 'FlowFormHQ',
    url: 'https://flowformhq.com',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
};
---

<SiteLayout
  title={`FlowForm vs ${competitor.name} (${competitor.family}) - FlowForm`}
  description={competitor.summary}
  canonical={canonical}
  ogType="article"
  activeNav="compare"
  schemaOrg={schemaOrg}
>
  <section class="max-w-5xl mx-auto px-6 py-14 sm:py-20">
    <nav class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-gray-900 dark:hover:text-white">Home</a>
      <span>/</span>
      <a href="/compare" class="hover:text-gray-900 dark:hover:text-white">Compare</a>
      <span>/</span>
      <span class="text-gray-900 dark:text-gray-100 font-medium">FlowForm vs {competitor.name}</span>
    </nav>

    <div class="inline-flex items-center gap-2 rounded-full border border-indigo-200 dark:border-cyan-500/30 bg-indigo-50 dark:bg-cyan-500/10 px-3 py-1 text-xs font-semibold text-indigo-700 dark:text-cyan-300 mb-4">
      <span>{competitor.family} Comparison</span>
      <span>&middot;</span>
      <span>Data as of {competitor.asOfDate}</span>
    </div>

    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-gray-900 dark:text-white leading-tight">
      FlowForm vs {competitor.name}
    </h1>
    <p class="mt-3 text-lg text-gray-600 dark:text-gray-300 leading-relaxed max-w-3xl">
      {competitor.tagline}.
    </p>

    <div class="mt-6 rounded-xl border border-amber-200 dark:border-amber-800/60 bg-amber-50/70 dark:bg-amber-950/20 px-4 py-3 text-xs text-amber-900 dark:text-amber-200 flex flex-wrap items-center justify-between gap-2">
      <span>
        <strong>Factual pricing &amp; limits source:</strong> Verified from <a href={competitor.sourceUrl} target="_blank" rel="noopener noreferrer" class="underline font-semibold hover:opacity-80">{competitor.sourceUrl}</a> as of <strong>{competitor.asOfDate}</strong>.
      </span>
      <span>FlowForm hosted Cloud Free (250/mo) is marked PLANNED until launch.</span>
    </div>

    <p class="mt-6 text-base text-gray-700 dark:text-gray-300 leading-relaxed">
      {competitor.summary}
    </p>

    <div class="mt-10 rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-sm">
      <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-3">
        {competitor.name} Public Pricing Snapshot (as of {competitor.asOfDate})
      </h2>
      <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-300 list-disc pl-5">
        {competitor.pricingSnapshot.map((line) => (
          <li>{line}</li>
        ))}
      </ul>
      <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
        Source: <a href={competitor.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-indigo-600 dark:text-cyan-400 underline">{competitor.sourceUrl}</a> (checked {competitor.asOfDate}).
      </p>
    </div>

    <div class="mt-10 overflow-x-auto rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-sm">
      <table class="w-full text-left border-collapse text-sm">
        <caption class="sr-only">Factual comparison between FlowForm and {competitor.name} as of {competitor.asOfDate}</caption>
        <thead>
          <tr class="border-b border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950/60">
            <th scope="col" class="py-4 px-5 font-semibold text-gray-700 dark:text-gray-300 w-1/4">Dimension</th>
            <th scope="col" class="py-4 px-5 font-bold text-indigo-700 dark:text-cyan-400 w-[37.5%]">FlowForm (OSS + Planned Cloud)</th>
            <th scope="col" class="py-4 px-5 font-semibold text-gray-700 dark:text-gray-300 w-[37.5%]">{competitor.name}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
          {competitor.rows.map((row) => (
            <tr>
              <th scope="row" class="py-4 px-5 font-medium text-gray-900 dark:text-gray-100 align-top">{row.dimension}</th>
              <td class="py-4 px-5 text-gray-700 dark:text-gray-200 align-top bg-indigo-50/30 dark:bg-cyan-950/10">{row.flowform}</td>
              <td class="py-4 px-5 text-gray-600 dark:text-gray-400 align-top">{row.competitor}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-10 grid md:grid-cols-2 gap-6">
      <div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6">
        <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-3">When {competitor.name} makes sense</h2>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-300 list-disc pl-5">
          {competitor.chooseCompetitor.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-indigo-200 dark:border-cyan-500/40 bg-indigo-50/40 dark:bg-gray-900 p-6">
        <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-3">When FlowForm makes sense</h2>
        <ul class="space-y-2 text-sm text-gray-700 dark:text-gray-200 list-disc pl-5">
          {competitor.chooseFlowform.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 rounded-2xl bg-gray-950 border border-gray-800 p-6 sm:p-8 text-gray-100">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4">
        <div>
          <h2 class="text-lg font-bold text-white">Drop-in HTML Endpoint Example</h2>
          <p class="text-xs text-gray-400 mt-1">Start in 30 seconds with a plain HTML form, then grow into multi-step schemas without changing tools.</p>
        </div>
        <div class="flex flex-wrap gap-3 text-xs">
          <a href="https://docs.flowformhq.com/guide/endpoints/" class="rounded-lg bg-cyan-500 text-gray-950 font-semibold px-3.5 py-2 hover:bg-cyan-400 transition">Endpoint Docs</a>
          <a href="https://docs.flowformhq.com/guide/ai-agents" class="rounded-lg border border-gray-700 text-gray-200 font-semibold px-3.5 py-2 hover:bg-gray-800 transition">AI Agents Guide</a>
        </div>
      </div>
      <pre class="text-xs sm:text-sm text-emerald-400 font-mono overflow-x-auto leading-relaxed"><code>&lt;form action="https://demo.flowformhq.com/f/&#123;slug&#125;" method="POST"&gt;
  &lt;input type="email" name="email" required /&gt;
  &lt;textarea name="message" required&gt;&lt;/textarea&gt;
  &lt;input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" /&gt;
  &lt;input type="hidden" name="_next" value="https://yoursite.example/thanks" /&gt;
  &lt;button type="submit"&gt;Send&lt;/button&gt;
&lt;/form&gt;</code></pre>
    </div>

    <div class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-800">
      <h2 class="text-sm font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-4">Compare Other Alternatives</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {others.map((item) => (
          <a href={`/vs/${item.slug}`} class="rounded-xl border border-gray-200 dark:border-gray-800 p-4 hover:border-indigo-400 dark:hover:border-cyan-500 transition bg-white dark:bg-gray-900">
            <div class="text-[11px] font-semibold uppercase tracking-wider text-indigo-600 dark:text-cyan-400">{item.family}</div>
            <div class="font-bold text-gray-900 dark:text-white mt-1">FlowForm vs {item.name}</div>
            <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">As of {item.asOfDate} &rarr;</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>
