---
import SiteLayout from '../layouts/SiteLayout.astro';
import { AS_OF_DATE, COMPETITORS } from '../data/comparisons';

const backends = COMPETITORS.filter((c) => c.family === 'Form Backend');
const builders = COMPETITORS.filter((c) => c.family === 'Form Builder');

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'FlowForm',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, Docker, Kubernetes',
  description:
    'A form endpoint in 30 seconds. Grow into multi-step workflows without switching tools. Open-source AGPLv3 engine with MIT SDKs and starter kits.',
  url: 'https://flowformhq.com',
  offers: [
    {
      '@type': 'Offer',
      name: 'OSS Self-Hosted (AGPLv3)',
      price: '0',
      priceCurrency: 'USD',
      description: 'Self-hosted form endpoint and multi-step workflow engine with no software-imposed submission quotas.',
    },
  ],
};
---

<SiteLayout
  title="FlowForm - A form endpoint in 30 seconds. Grow into multi-step workflows without switching tools."
  description="Point any HTML form at FlowForm in 30 seconds, then grow into schema-driven multi-step workflows, signed webhooks, and REST/MCP APIs without switching tools."
  canonical="https://flowformhq.com/"
  activeNav="home"
  schemaOrg={schemaOrg}
>
  <!-- Hero Above the Fold -->
  <section id="quickstart" class="relative overflow-hidden py-14 sm:py-20 bg-gradient-to-b from-slate-50 via-white to-white dark:from-[#0B0F19] dark:via-[#0B0F19] dark:to-[#0F172A] border-b border-gray-100 dark:border-gray-800/80">
    <div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-indigo-200 dark:border-cyan-500/30 bg-indigo-50 dark:bg-cyan-500/10 px-3.5 py-1 text-xs font-semibold text-indigo-700 dark:text-cyan-300">
          <span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
          <span>Open-Source AGPLv3 Engine &middot; MIT SDKs &amp; Starter Kits</span>
        </div>

        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-gray-900 dark:text-white leading-[1.12]">
          A form endpoint in 30 seconds. Grow into multi-step workflows without switching tools.
        </h1>

        <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
          Point any raw HTML <code>&lt;form&gt;</code> at <code>/f/&#123;slug&#125;</code> for honeypot spam filtering, redirects, database persistence, and HMAC-signed webhooks. When your flow outgrows one step, enable multi-step JSON schemas and conditional logic inside the same engine.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a href="https://docs.flowformhq.com/guide/endpoints/"
            class="inline-flex items-center justify-center rounded-xl bg-indigo-600 dark:bg-cyan-500 px-5 py-3 text-sm font-semibold text-white dark:text-gray-950 shadow-sm hover:bg-indigo-700 dark:hover:bg-cyan-400 transition">
            Endpoint Quickstart Docs &rarr;
          </a>
          <a href="https://docs.flowformhq.com/guide/ai-agents"
            class="inline-flex items-center justify-center rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-5 py-3 text-sm font-semibold text-gray-800 dark:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-800 transition">
            AI Agents &amp; MCP Guide
          </a>
          <a href="https://github.com/Flowformhq/flowform" target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-xl px-4 py-3 text-sm font-semibold text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition">
            GitHub Source
          </a>
        </div>

        <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">
          Zero client JavaScript needed when using the built-in <code>_gotcha</code> honeypot (adding Turnstile or hCaptcha loads the captcha widget script).
        </p>
      </div>

      <!-- Above-the-Fold Copy-Paste Snippet -->
      <div class="lg:col-span-6">
        <div class="rounded-2xl bg-gray-950 border border-gray-800 shadow-2xl overflow-hidden">
          <div class="flex items-center justify-between border-b border-gray-800 bg-gray-900/90 px-4 py-3">
            <div class="flex items-center gap-2" role="tablist" aria-label="Code workflow progression">
              <button id="snippet-tab-endpoint" type="button" role="tab" aria-selected="true"
                class="rounded-md bg-cyan-500/15 border border-cyan-500/40 px-3 py-1 text-xs font-semibold text-cyan-300">
                1. HTML Endpoint (30s)
              </button>
              <button id="snippet-tab-workflow" type="button" role="tab" aria-selected="false"
                class="rounded-md border border-transparent px-3 py-1 text-xs font-semibold text-gray-400 hover:text-white">
                2. Multi-Step Workflow API
              </button>
            </div>
            <button id="copy-quickstart" type="button"
              class="rounded-md bg-gray-800 hover:bg-gray-700 border border-gray-700 px-2.5 py-1 text-xs font-mono text-gray-200 transition">
              Copy
            </button>
          </div>

          <div class="p-5 overflow-x-auto">
            <pre class="text-xs sm:text-[13px] leading-relaxed font-mono text-emerald-400"><code id="quickstart-code">&lt;!-- Paste into any HTML, Astro, Hugo, or WordPress page --&gt;
&lt;form action="https://demo.flowformhq.com/f/&#123;slug&#125;" method="POST"&gt;
  &lt;label&gt;Email &lt;input type="email" name="email" required /&gt;&lt;/label&gt;
  &lt;label&gt;Message &lt;textarea name="message" required&gt;&lt;/textarea&gt;&lt;/label&gt;

  &lt;!-- Built-in honeypot spam trap --&gt;
  &lt;input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" /&gt;

  &lt;!-- Full redirect URL on an Allowed Domain --&gt;
  &lt;input type="hidden" name="_next" value="https://yoursite.example/thanks" /&gt;

  &lt;button type="submit"&gt;Send Message&lt;/button&gt;
&lt;/form&gt;</code></pre>
          </div>

          <div class="border-t border-gray-800 bg-gray-900/60 px-5 py-3 flex flex-wrap items-center justify-between gap-2 text-xs text-gray-400">
            <span>Works with standard POST, AJAX JSON (<code>/api/v1/f/&#123;slug&#125;</code>), and server webhooks.</span>
            <a href="https://docs.flowformhq.com/guide/endpoints/" class="text-cyan-400 font-semibold hover:underline">Endpoint Reference &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Upgrade Path / Architecture Pillars -->
  <section id="workflow" class="py-16 sm:py-20 max-w-6xl mx-auto px-6">
    <div class="max-w-3xl mb-12">
      <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white">
        One codebase from contact form to branching workflow
      </h2>
      <p class="mt-3 text-base text-gray-600 dark:text-gray-300 leading-relaxed">
        Avoid re-building your form backend when an integration or multi-step intake lands in the sprint. Keep your endpoint slug, submissions database, and webhook subscribers intact.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6">
        <div class="text-xs font-mono font-bold text-indigo-600 dark:text-cyan-400 uppercase tracking-wider">Step 01 &middot; Endpoint</div>
        <h3 class="mt-2 text-lg font-bold text-gray-900 dark:text-white">Drop-in HTML &amp; JSON</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Accept form-encoded POSTs at <code>/f/&#123;slug&#125;</code> or JSON at <code>/api/v1/f/&#123;slug&#125;</code> with Origin/Allowed Domain checks, full-URL <code>_next</code> redirects, and server secrets.
        </p>
      </div>

      <div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6">
        <div class="text-xs font-mono font-bold text-indigo-600 dark:text-cyan-400 uppercase tracking-wider">Step 02 &middot; Wizards</div>
        <h3 class="mt-2 text-lg font-bold text-gray-900 dark:text-white">Multi-Step Schemas</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Serve versioned JSON schemas via <code>GET /api/v1/forms/&#123;uuid&#125;/schema</code>, save partial step values, and evaluate conditional jumps server-side in React, Vue 3, or Livewire.
        </p>
      </div>

      <div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6">
        <div class="text-xs font-mono font-bold text-indigo-600 dark:text-cyan-400 uppercase tracking-wider">Step 03 &middot; Integrations</div>
        <h3 class="mt-2 text-lg font-bold text-gray-900 dark:text-white">Signed Webhooks &amp; Logs</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Deliver payloads with <code>X-FlowForm-Signature-256</code> HMAC verification, SSRF target checks, delivery logs, and manual retry. Delivery and SMTP reliability track your queue worker and mail host configuration.
        </p>
      </div>

      <div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6">
        <div class="text-xs font-mono font-bold text-indigo-600 dark:text-cyan-400 uppercase tracking-wider">Step 04 &middot; Agents &amp; API</div>
        <h3 class="mt-2 text-lg font-bold text-gray-900 dark:text-white">OpenAPI v1 &amp; MCP</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Scoped Sanctum tokens (<code>forms:read</code>, <code>submissions:read</code>, <code>webhooks:manage</code>), audit-logged decryption, and <a href="https://docs.flowformhq.com/guide/ai-agents" class="text-indigo-600 dark:text-cyan-400 underline">AI coding agent docs</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Demo Video Placeholder Slot (Owner Task per ADR-0001) -->
  <section id="demo-video" class="py-14 bg-slate-50 dark:bg-gray-900/50 border-y border-gray-100 dark:border-gray-800">
    <div class="max-w-5xl mx-auto px-6">
      <div class="rounded-2xl border-2 border-dashed border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 p-8 sm:p-12 text-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-gray-100 dark:bg-gray-800 px-3 py-1 text-xs font-semibold text-gray-700 dark:text-gray-300">
          Video Slot &middot; Placeholder Pending Owner Recording
        </span>
        <h2 class="mt-4 text-2xl font-extrabold text-gray-900 dark:text-white">
          90-Second Engine Walkthrough
        </h2>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          This section reserves the demo walkthrough video: (1) create an endpoint slug in the Filament admin UI, (2) submit from plain HTML in 30 seconds, and (3) upgrade that same form into a multi-step conditional schema with webhook delivery logs.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="https://demo.flowformhq.com" target="_blank" rel="noopener noreferrer"
            class="rounded-xl bg-indigo-600 dark:bg-cyan-500 text-white dark:text-gray-950 px-5 py-2.5 text-sm font-semibold hover:bg-indigo-700 dark:hover:bg-cyan-400 transition">
            Explore Live Sandbox Now
          </a>
          <a href="https://docs.flowformhq.com/guide/endpoints/"
            class="rounded-xl border border-gray-300 dark:border-gray-700 px-5 py-2.5 text-sm font-semibold text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800 transition">
            Follow Written Quickstart
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Two-Family Competitor Comparisons -->
  <section id="comparisons" class="py-16 sm:py-20 max-w-6xl mx-auto px-6">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-cyan-400">Factual Comparisons &middot; As of {AS_OF_DATE}</div>
        <h2 class="mt-2 text-2xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white">
          Compare against Form Backends and Form Builders
        </h2>
        <p class="mt-2 text-sm sm:text-base text-gray-600 dark:text-gray-300">
          Every figure below is cited directly from each vendor's public pricing page as of {AS_OF_DATE}.
        </p>
      </div>
      <a href="/compare" class="text-sm font-semibold text-indigo-600 dark:text-cyan-400 hover:underline shrink-0">
        View comparison matrix &rarr;
      </a>
    </div>

    <div class="grid lg:grid-cols-2 gap-8">
      <!-- Form Backends Family -->
      <div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-sm">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-1">Form Backends</h3>
        <p class="text-xs text-gray-500 dark:text-gray-400 mb-5">Drop-in endpoint competitors for static sites and custom HTML forms.</p>
        <div class="space-y-4">
          {backends.map((item) => (
            <div class="rounded-xl border border-gray-100 dark:border-gray-800 p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <div class="font-bold text-gray-900 dark:text-white">FlowForm vs {item.name}</div>
                <div class="text-xs text-gray-600 dark:text-gray-400 mt-0.5">{item.pricingSnapshot[0]}</div>
                <div class="text-[11px] text-gray-500 dark:text-gray-400 mt-1">
                  Source: <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer" class="underline">{item.sourceLabel}</a> (as of {item.asOfDate})
                </div>
              </div>
              <a href={`/vs/${item.slug}`} class="shrink-0 text-xs font-semibold text-indigo-600 dark:text-cyan-400 hover:underline">
                Compare &rarr;
              </a>
            </div>
          ))}
        </div>
      </div>

      <!-- Form Builders Family -->
      <div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-sm">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-1">Form Builders</h3>
        <p class="text-xs text-gray-500 dark:text-gray-400 mb-5">Hosted multi-step and survey builders for onboarding and lead intake.</p>
        <div class="space-y-4">
          {builders.map((item) => (
            <div class="rounded-xl border border-gray-100 dark:border-gray-800 p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <div class="font-bold text-gray-900 dark:text-white">FlowForm vs {item.name}</div>
                <div class="text-xs text-gray-600 dark:text-gray-400 mt-0.5">{item.pricingSnapshot[1] ?? item.pricingSnapshot[0]}</div>
                <div class="text-[11px] text-gray-500 dark:text-gray-400 mt-1">
                  Source: <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer" class="underline">{item.sourceLabel}</a> (as of {item.asOfDate})
                </div>
              </div>
              <a href={`/vs/${item.slug}`} class="shrink-0 text-xs font-semibold text-indigo-600 dark:text-cyan-400 hover:underline">
                Compare &rarr;
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Teaser (ADR D4) -->
  <section id="pricing" class="py-16 sm:py-20 bg-slate-50 dark:bg-gray-900/50 border-t border-gray-100 dark:border-gray-800">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-cyan-400">Pricing</div>
        <h2 class="mt-2 text-2xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white">
          Self-host free today. Hosted Cloud Free planned.
        </h2>
        <p class="mt-3 text-sm sm:text-base text-gray-600 dark:text-gray-300">
          The full open-source engine is available now for self-hosting with no software-imposed quotas. Hosted FlowForm Cloud tiers are in planning and are not yet live.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- OSS Self-Hosted -->
        <div class="rounded-2xl border-2 border-indigo-600 dark:border-cyan-500 bg-white dark:bg-gray-900 p-8 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 px-3 py-1 text-xs font-bold">Available Now</span>
              <span class="text-xs font-mono text-gray-500 dark:text-gray-400">AGPLv3 + MIT Kits</span>
            </div>
            <h3 class="mt-4 text-2xl font-extrabold text-gray-900 dark:text-white">OSS Self-Hosted</h3>
            <div class="mt-2 flex items-baseline gap-2">
              <span class="text-4xl font-extrabold text-gray-900 dark:text-white">$0</span>
              <span class="text-sm text-gray-500 dark:text-gray-400">platform fee</span>
            </div>
            <p class="mt-3 text-sm text-gray-600 dark:text-gray-300">
              Deploy on your own VPS, Docker host, or Kubernetes cluster with SQLite, PostgreSQL, or MySQL. No software-imposed limits on forms, fields, submissions, or admin users.
            </p>
            <ul class="mt-6 space-y-2.5 text-sm text-gray-700 dark:text-gray-200">
              <li class="flex items-start gap-2"><span class="text-emerald-600 dark:text-cyan-400 font-bold shrink-0">&#10003;</span><span>HTML endpoints (<code>/f/&#123;slug&#125;</code>) &amp; multi-step schemas</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-600 dark:text-cyan-400 font-bold shrink-0">&#10003;</span><span>Signed webhooks (<code>X-FlowForm-Signature-256</code>) + retry logs</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-600 dark:text-cyan-400 font-bold shrink-0">&#10003;</span><span>OpenAPI v1 REST API, scoped tokens &amp; MCP endpoints</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-600 dark:text-cyan-400 font-bold shrink-0">&#10003;</span><span>Optional Commercial License available for non-AGPL teams</span></li>
            </ul>
          </div>
          <div class="mt-8">
            <a href="https://docs.flowformhq.com/guide/endpoints/"
              class="block w-full text-center rounded-xl bg-indigo-600 dark:bg-cyan-500 text-white dark:text-gray-950 font-semibold py-3 text-sm hover:bg-indigo-700 dark:hover:bg-cyan-400 transition">
              Deploy Self-Hosted Engine
            </a>
          </div>
        </div>

        <!-- Hosted Cloud Free (PLANNED) -->
        <div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-8 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800 px-3 py-1 text-xs font-bold uppercase tracking-wide">Planned</span>
              <span class="text-xs font-mono text-gray-500 dark:text-gray-400">Hosted SaaS Roadmap</span>
            </div>
            <h3 class="mt-4 text-2xl font-extrabold text-gray-900 dark:text-white">FlowForm Cloud Free</h3>
            <div class="mt-2 flex items-baseline gap-2">
              <span class="text-4xl font-extrabold text-gray-900 dark:text-white">$0</span>
              <span class="text-sm text-gray-500 dark:text-gray-400">/ mo (planned)</span>
            </div>
            <p class="mt-3 text-sm text-gray-600 dark:text-gray-300">
              Target hosted entry tier: <strong>250 submissions / month</strong> once FlowForm Cloud launches. Hosted tiers are <strong>planned</strong> and are not accepting live production workloads or paid billing yet.
            </p>
            <ul class="mt-6 space-y-2.5 text-sm text-gray-600 dark:text-gray-300">
              <li class="flex items-start gap-2"><span class="text-indigo-500 dark:text-cyan-400">&bull;</span> Planned cap: 250 submissions / month</li>
              <li class="flex items-start gap-2"><span class="text-indigo-500 dark:text-cyan-400">&bull;</span> Managed hosting &amp; hosted email relay (when live)</li>
              <li class="flex items-start gap-2"><span class="text-indigo-500 dark:text-cyan-400">&bull;</span> Clean export &amp; migration to self-hosted engine anytime</li>
            </ul>
          </div>

          <form id="cloud-waitlist-form" class="mt-6 pt-6 border-t border-gray-100 dark:border-gray-800 space-y-3">
            <label for="wl-email" class="block text-xs font-semibold text-gray-700 dark:text-gray-300">
              Get notified when FlowForm Cloud opens:
            </label>
            <div class="flex gap-2">
              <input id="wl-email" name="email" type="email" required placeholder="you@company.com"
                class="flex-1 rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:focus:ring-cyan-500" />
              <button id="waitlist-submit" type="submit"
                class="rounded-xl border border-gray-300 dark:border-gray-700 bg-gray-900 dark:bg-gray-800 text-white px-4 py-2.5 text-xs font-semibold hover:bg-gray-800 dark:hover:bg-gray-700 transition shrink-0">
                Notify Me
              </button>
            </div>
            <p id="waitlist-feedback" hidden class="text-xs text-emerald-700 dark:text-emerald-400">
              Recorded your early-interest request for when FlowForm Cloud launches.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
