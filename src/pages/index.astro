---
import '../style.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>FlowForm — The Open-Source Forms Platform</title>
  <meta name="description" content="Headless, API-first form and workflow engine. Open-source, self-hostable with $0 platform pricing, or fully managed cloud SaaS with instant setup." />
  <link rel="canonical" href="https://flowformhq.com/" />

  <!-- Theme detection script (Zero FOUT) -->
  <script is:inline>
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>

  <!-- Icons -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="FlowForm" />
  <meta property="og:url" content="https://flowformhq.com/" />
  <meta property="og:title" content="FlowForm — The Open-Source Forms Platform" />
  <meta property="og:description" content="Headless, API-first form and workflow engine for developers. Build multi-step forms with conditional logic. Self-host or use our managed SaaS." />
  <meta property="og:image" content="https://flowformhq.com/og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="FlowForm — the open-source forms platform" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="FlowForm — The Open-Source Forms Platform" />
  <meta name="twitter:description" content="Headless, API-first form and workflow engine for developers. Build multi-step forms with conditional logic. Self-host or use our managed SaaS." />
  <meta name="twitter:image" content="https://flowformhq.com/og.png" />

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://flowformhq.com/#org",
        "name": "FlowFormHQ",
        "url": "https://flowformhq.com/",
        "logo": "https://flowformhq.com/og.png",
        "sameAs": ["https://github.com/Flowformhq"]
      },
      {
        "@type": "SoftwareApplication",
        "name": "FlowForm",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Linux, macOS, Docker",
        "description": "Headless, API-first form and workflow engine. Build multi-step forms with server-evaluated conditional logic. Self-hostable under AGPLv3 or managed Cloud SaaS.",
        "url": "https://flowformhq.com/",
        "offers": [
          {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD",
            "description": "Community Self-Hosted (AGPLv3) — Free Forever"
          },
          {
            "@type": "Offer",
            "price": "29",
            "priceCurrency": "USD",
            "description": "Managed Cloud SaaS — Zero Ops & Team Collaboration"
          }
        ]
      }
    ]
  }
  </script>
</head>
<body class="bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100 antialiased font-sans transition-colors duration-200">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-indigo-600 focus:px-4 focus:py-2 focus:text-white">Skip to content</a>

  <!-- Top Announcement Bar -->
  <div class="bg-gradient-to-r from-indigo-900 via-indigo-800 to-indigo-900 text-white text-xs sm:text-sm py-2 px-4 text-center font-medium">
    <span>🚀 FlowForm Engine v0.1 is Live!</span>
    <span class="mx-2 opacity-60">·</span>
    <a href="https://demo.flowformhq.com" target="_blank" class="underline hover:text-indigo-200">Explore Interactive Demo →</a>
  </div>

  <nav class="border-b border-gray-100 dark:border-gray-800 bg-white/90 dark:bg-gray-950/90 backdrop-blur sticky top-0 z-50" aria-label="Main">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
        <img src="/brand/flowform-logo-light.svg" alt="FlowForm" class="h-8 w-auto dark:hidden" />
        <img src="/brand/flowform-logo-dark.svg" alt="FlowForm" class="h-8 w-auto hidden dark:block" />
      </a>

      <div class="hidden md:flex items-center gap-6 text-sm">
        <a href="https://docs.flowformhq.com" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white font-medium">Docs</a>
        <a href="/blog" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white font-medium">Blog</a>
        <a href="https://demo.flowformhq.com" target="_blank" class="text-indigo-600 dark:text-cyan-400 hover:text-indigo-700 dark:hover:text-cyan-300 font-medium flex items-center gap-1">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Live Demo
        </a>
        <a href="#features" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Features</a>
        <a href="#pricing" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white font-medium">Pricing</a>
        <a href="#compare" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Compare</a>
        <a href="#roadmap" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Roadmap</a>
        <a href="https://api.flowformhq.com/admin/register" target="_blank" class="rounded-md bg-indigo-600 text-white px-3.5 py-1.5 font-medium hover:bg-indigo-700 shadow-sm transition">
          Sign Up Free →
        </a>
        <a href="https://github.com/Flowformhq/flowform" target="_blank" class="inline-flex items-center gap-1.5 rounded-md border border-gray-300 dark:border-gray-700 px-3 py-1.5 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          GitHub
        </a>

        <!-- Dark/Light Theme Toggle -->
        <button type="button" aria-label="Toggle dark mode"
          class="theme-toggle-btn rounded-md border border-gray-300 dark:border-gray-700 p-2 text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition">
          <svg class="h-4 w-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="h-4 w-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
      </div>

      <div class="flex items-center gap-2 md:hidden">
        <button type="button" aria-label="Toggle dark mode"
          class="theme-toggle-btn rounded-md border border-gray-300 dark:border-gray-700 p-2 text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition">
          <svg class="h-4 w-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="h-4 w-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <button type="button" id="nav-toggle" aria-expanded="false" aria-controls="nav-mobile"
          class="inline-flex items-center justify-center rounded-md border border-gray-300 dark:border-gray-700 p-2 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
          <span class="sr-only">Open main menu</span>
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>

    <div id="nav-mobile" hidden class="md:hidden border-t border-gray-100 dark:border-gray-800 px-6 pb-4 pt-2 space-y-2">
      <a href="https://docs.flowformhq.com" class="block py-2 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Docs</a>
      <a href="/blog" class="block py-2 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Blog</a>
      <a href="https://demo.flowformhq.com" target="_blank" class="block py-2 text-indigo-600 dark:text-cyan-400 font-semibold">Live Demo</a>
      <a href="#features" class="block py-2 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Features</a>
      <a href="#compare" class="block py-2 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Compare</a>
      <a href="#roadmap" class="block py-2 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Roadmap</a>
      <a href="#waitlist" class="block py-2 text-indigo-600 dark:text-cyan-400 font-medium">Cloud Trial Waitlist</a>
      <a href="https://github.com/Flowformhq/flowform" class="mt-2 inline-flex items-center gap-1.5 rounded-md border border-gray-300 dark:border-gray-700 px-3 py-1.5 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800">
        GitHub
      </a>
    </div>
  </nav>

  <main id="main">
  <!-- Hero Section -->
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-16 text-center">
    
    <!-- Mode Switcher Pill Container -->
    <div class="inline-flex p-1 rounded-xl bg-gray-100 border border-gray-200 mb-8 shadow-inner" role="tablist" aria-label="Form Engine Mode">
      <button type="button" id="tab-mode1" role="tab" aria-selected="true" aria-controls="mode-content"
        class="flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold transition shadow-sm bg-white text-indigo-700">
        <span>⚡ Mode 1: Simple Headless Form</span>
        <span class="text-xs bg-indigo-100 text-indigo-800 font-mono px-2 py-0.5 rounded-full hidden sm:inline">Web3Forms / Formspree</span>
      </button>
      <button type="button" id="tab-mode2" role="tab" aria-selected="false" aria-controls="mode-content"
        class="flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold transition text-gray-600 hover:text-gray-900">
        <span>🔀 Mode 2: Multi-Step Dynamic Wizard</span>
        <span class="text-xs bg-gray-200 text-gray-700 font-mono px-2 py-0.5 rounded-full hidden sm:inline">Typeform / Tally</span>
      </button>
    </div>

    <!-- Badge -->
    <p id="hero-badge" class="inline-flex items-center gap-2 rounded-full bg-indigo-50 px-4 py-1.5 text-sm text-indigo-700 mb-6 font-medium">
      Mode 1 &middot; Web3Forms &amp; Formspree Alternative &middot; Zero-JS HTML Endpoint
    </p>

    <!-- Main Heading -->
    <h1 id="hero-heading" class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-tight text-gray-900">
      Simple form backend<br/><span class="text-indigo-600">for static sites</span>
    </h1>

    <!-- Subtitle -->
    <p id="hero-desc" class="mt-6 text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
      Point any raw HTML form to FlowForm. Zero client JavaScript required. Automatic spam honeypot defense, instant email forwarding, and clean JSON payload storage.
    </p>

    <!-- Hero Action Buttons -->
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a id="hero-primary-cta" href="https://api.flowformhq.com/admin/register" target="_blank" class="w-full sm:w-auto rounded-lg bg-indigo-600 px-7 py-3.5 text-base font-semibold text-white hover:bg-indigo-700 shadow-md hover:shadow-lg transition">
        Create Free Endpoint →
      </a>
      <a id="hero-secondary-cta" href="https://docs.flowformhq.com" class="w-full sm:w-auto rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-7 py-3.5 text-base font-semibold text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800 shadow-sm transition flex items-center justify-center gap-2">
        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
        Read Documentation
      </a>
    </div>

    <p id="hero-footnote" class="mt-4 text-xs sm:text-sm text-gray-500">
      Works with Astro, Next.js, Hugo, or raw HTML &middot; 100% data sovereignty &middot; $0 platform fees
    </p>
  </section>

  <!-- Interactive Terminal / Code Block Section -->
  <section class="bg-gray-50 py-16" aria-label="Quickstart and Architecture">
    <div class="max-w-5xl mx-auto px-6">
      <div class="relative rounded-2xl bg-gray-900 p-6 sm:p-10 shadow-2xl border border-gray-800">
        <div class="flex items-center justify-between pb-4 border-b border-gray-800 mb-6">
          <div class="flex items-center gap-2">
            <span class="h-3 w-3 rounded-full bg-red-500" aria-hidden="true"></span>
            <span class="h-3 w-3 rounded-full bg-yellow-500" aria-hidden="true"></span>
            <span class="h-3 w-3 rounded-full bg-green-500" aria-hidden="true"></span>
            <span id="terminal-label" class="ml-3 text-xs sm:text-sm text-gray-400 font-mono font-medium">html — mode 1: simple contact form endpoint</span>
          </div>
          <button type="button" id="copy-quickstart" data-target="quickstart-code"
            class="rounded-md border border-gray-700 bg-gray-800 px-3 py-1.5 text-xs text-gray-300 hover:bg-gray-700 hover:text-white transition font-mono">
            Copy
          </button>
        </div>
        
        <pre class="text-xs sm:text-sm text-emerald-400 font-mono leading-relaxed overflow-x-auto"><code id="quickstart-code">&lt;!-- Mode 1: Simple Headless Form (Web3Forms / Formspree Alternative) --&gt;
&lt;!-- Point any static HTML form directly to your FlowForm endpoint --&gt;
&lt;form action="https://demo.flowformhq.com/f/contact" method="POST"&gt;
  &lt;input type="text" name="name" placeholder="Your Name" required /&gt;
  &lt;input type="email" name="email" placeholder="you@company.com" required /&gt;
  &lt;textarea name="message" placeholder="How can we help?"&gt;&lt;/textarea&gt;

  &lt;!-- Spam honeypot: bots fill this and get quietly dropped --&gt;
  &lt;input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" /&gt;

  &lt;!-- Custom redirect URL after successful submission --&gt;
  &lt;input type="hidden" name="_next" value="https://mysite.com/thanks" /&gt;

  &lt;button type="submit"&gt;Send Message&lt;/button&gt;
&lt;/form&gt;

&lt;!-- Or post arbitrary JSON via cURL / AJAX: --&gt;
&lt;!-- curl -X POST https://demo.flowformhq.com/api/v1/f/contact -H "Content-Type: application/json" -d '&#123;"email":"lead@co.com"&#125;' --&gt;</code></pre>
      </div>
    </div>
  </section>

  <!-- Key Value Pillars (Features) -->
  <section id="features" class="py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Engineered for developers who demand full control</h2>
        <p class="mt-4 text-lg text-gray-600">Stop wrestling with proprietary form builders that hold your submissions hostage. Build fast, scale infinitely, and own your stack.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="rounded-xl border border-gray-200 p-8 hover:shadow-lg transition bg-white">
          <div class="h-10 w-10 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-xl mb-5">🔀</div>
          <h3 class="font-bold text-xl mb-3 text-gray-900">Multi-Step Dynamic Wizards</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Break friction with step-by-step forms. Real-time progress tracking, field upserts, and clean payload schemas.</p>
        </div>

        <div class="rounded-xl border border-gray-200 p-8 hover:shadow-lg transition bg-white">
          <div class="h-10 w-10 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-xl mb-5">⚡</div>
          <h3 class="font-bold text-xl mb-3 text-gray-900">Server-Evaluated Conditional Logic</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Show, hide, or mandate fields dynamically. Rules evaluate on the server, preventing tampering and frontend bloat.</p>
        </div>

        <div class="rounded-xl border border-gray-200 p-8 hover:shadow-lg transition bg-white">
          <div class="h-10 w-10 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-xl mb-5">🔌</div>
          <h3 class="font-bold text-xl mb-3 text-gray-900">Agentic & API-First (OpenAPI 3.1)</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Complete REST API contract and Model Context Protocol (MCP) support for AI agents to discover schemas and submit workflows autonomously.</p>
        </div>

        <div class="rounded-xl border border-gray-200 p-8 hover:shadow-lg transition bg-white">
          <div class="h-10 w-10 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-xl mb-5">🛡️</div>
          <h3 class="font-bold text-xl mb-3 text-gray-900">100% Data Sovereignty</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Keep sensitive respondent PII inside your own infrastructure. Zero third-party tracker scripts. GDPR and HIPAA compliant by default.</p>
        </div>

        <div class="rounded-xl border border-gray-200 p-8 hover:shadow-lg transition bg-white">
          <div class="h-10 w-10 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-xl mb-5">💰</div>
          <h3 class="font-bold text-xl mb-3 text-gray-900">$0 Platform Fees</h3>
          <p class="text-gray-600 text-sm leading-relaxed">No arbitrary tier gates, seat limits, or submission charges. Run unlimited forms with unlimited responses on your existing VPS.</p>
        </div>

        <div class="rounded-xl border border-gray-200 p-8 hover:shadow-lg transition bg-white">
          <div class="h-10 w-10 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-xl mb-5">🎨</div>
          <h3 class="font-bold text-xl mb-3 text-gray-900">Framework-Agnostic Starter Kits</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Drop-in SDKs and ready-to-run kits for React + Vite, Vue 3, Next.js, and Laravel Livewire with shared rendering contracts.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Feature Comparison Table -->
  <section id="compare" class="bg-gray-50 py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Why FlowForm?</h2>
        <p class="mt-4 text-lg text-gray-600">The transparent, developer-first alternative to Typeform, Web3Forms, Formspree, and Tally.</p>
      </div>

      <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
        <table class="w-full text-sm border-collapse text-left">
          <caption class="sr-only">Feature comparison between FlowForm, Typeform, Formspree, and Web3Forms</caption>
          <thead>
            <tr class="border-b border-gray-200 bg-gray-50">
              <th scope="col" class="py-4 px-6 font-semibold text-gray-900">Feature</th>
              <th scope="col" class="py-4 px-6 font-bold text-indigo-700 bg-indigo-50/70">FlowForm (OSS & Cloud)</th>
              <th scope="col" class="py-4 px-6 font-semibold text-gray-600">Typeform</th>
              <th scope="col" class="py-4 px-6 font-semibold text-gray-600">Formspree / Web3Forms</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <tr>
              <th scope="row" class="py-4 px-6 font-medium text-gray-800">Open Source & Self-Hostable</th>
              <td class="py-4 px-6 font-semibold text-emerald-600 bg-indigo-50/30">Yes (AGPLv3)</td>
              <td class="py-4 px-6 text-gray-500">No (Proprietary)</td>
              <td class="py-4 px-6 text-gray-500">Closed Cloud Only</td>
            </tr>
            <tr>
              <th scope="row" class="py-4 px-6 font-medium text-gray-800">Platform License Fee</th>
              <td class="py-4 px-6 font-bold text-indigo-700 bg-indigo-50/30">$0 (Self-Host)</td>
              <td class="py-4 px-6 text-gray-600">$29 - $99+/month</td>
              <td class="py-4 px-6 text-gray-600">Per-submission tiers</td>
            </tr>
            <tr>
              <th scope="row" class="py-4 px-6 font-medium text-gray-800">Full Data Residency & Sovereignty</th>
              <td class="py-4 px-6 font-semibold text-emerald-600 bg-indigo-50/30">100% (Your Database)</td>
              <td class="py-4 px-6 text-gray-500">Vendor Locked</td>
              <td class="py-4 px-6 text-gray-500">Vendor Stored</td>
