---
import '../../style.css';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.publishDate,
  "dateModified": post.data.publishDate,
  "author": {
    "@type": "Organization",
    "name": post.data.author,
    "url": "https://flowformhq.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "FlowFormHQ",
    "url": "https://flowformhq.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://flowformhq.com/og.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://flowformhq.com/blog/${post.id}`
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{post.data.title} — FlowForm Blog</title>
  <meta name="description" content={post.data.description} />
  <link rel="canonical" href={post.data.canonicalUrl || `https://flowformhq.com/blog/${post.id}`} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- Theme detection & Instant toggle (Zero FOUT) -->
  <script is:inline>
    (function () {
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      if (!window.__themeToggleInitialized) {
        window.__themeToggleInitialized = true;
        document.addEventListener('click', function (e) {
          const btn = e.target.closest('.theme-toggle-btn');
          if (!btn) return;
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }
    })();
  </script>

  <!-- Open Graph -->
  <meta property="og:type" content="article" />
  <meta property="og:title" content={post.data.title} />
  <meta property="og:description" content={post.data.description} />
  <meta property="og:url" content={`https://flowformhq.com/blog/${post.id}`} />
  <meta property="og:image" content={post.data.ogImage || "https://flowformhq.com/og.png"} />
  <meta property="article:published_time" content={post.data.publishDate} />
  <meta property="article:author" content={post.data.author} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={post.data.title} />
  <meta name="twitter:description" content={post.data.description} />
  <meta name="twitter:image" content={post.data.ogImage || "https://flowformhq.com/og.png"} />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;600;700;800&family=Google+Sans+Text:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="bg-white dark:bg-[#0B0F19] text-gray-900 dark:text-gray-100 antialiased font-sans flex flex-col min-h-screen transition-colors duration-200">

  <!-- Header -->
  <header class="border-b border-gray-100 dark:border-gray-800 bg-white/80 dark:bg-[#0B0F19]/80 backdrop-blur-md sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <img src="/brand/flowform-logo-light.svg" alt="FlowForm" class="h-8 w-auto dark:hidden" />
        <img src="/brand/flowform-logo-dark.svg" alt="FlowForm" class="h-8 w-auto hidden dark:block" />
      </a>

      <div class="flex items-center gap-6 text-sm font-medium">
        <a href="/" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Home</a>
        <a href="/blog" class="text-indigo-600 dark:text-cyan-400 font-semibold">Blog</a>
        <a href="https://docs.flowformhq.com" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Docs</a>
        <a href="https://demo.flowformhq.com" target="_blank" class="rounded-md bg-indigo-600 dark:bg-cyan-500 text-white dark:text-gray-950 px-3 py-1.5 font-semibold hover:bg-indigo-700 dark:hover:bg-cyan-400 transition">
          Live Demo
        </a>

        <!-- Dark/Light Theme Toggle -->
        <button type="button" aria-label="Toggle dark mode"
          class="theme-toggle-btn rounded-md border border-gray-300 dark:border-gray-700 p-2 text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition">
          <svg class="h-4 w-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="h-4 w-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Article Container -->
  <main class="flex-1 max-w-4xl mx-auto px-6 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-gray-900 dark:hover:text-white">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:text-gray-900 dark:hover:text-white">Blog</a>
      <span>/</span>
      <span class="text-gray-900 dark:text-gray-100 font-medium truncate">{post.data.title}</span>
    </nav>

    <!-- Header Block -->
    <header class="mb-10 pb-8 border-b border-gray-100 dark:border-gray-800">
      <div class="inline-flex items-center gap-2 text-xs font-semibold text-indigo-700 dark:text-cyan-400 bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-100 dark:border-indigo-800 px-3 py-1 rounded-full mb-4">
        {post.data.category}
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight leading-tight mb-4">
        {post.data.title}
      </h1>
      <div class="flex items-center gap-4 text-xs text-gray-500 dark:text-gray-400">
        <span>By <strong class="text-gray-800 dark:text-gray-200">{post.data.author}</strong></span>
        <span>&bull;</span>
        <time datetime={post.data.publishDate}>{new Date(post.data.publishDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
        <span>&bull;</span>
        <span>Free &amp; Open Source (AGPLv3)</span>
      </div>
    </header>

    <!-- Article Content -->
    <article class="prose max-w-none text-gray-800 dark:text-gray-200 leading-relaxed space-y-6 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-gray-900 dark:[&_h2]:text-white [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:tracking-tight [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-gray-900 dark:[&_h3]:text-white [&_h3]:mt-6 [&_h3]:mb-3 [&_p]:text-base [&_p]:leading-relaxed [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-2 [&_table]:w-full [&_table]:border-collapse [&_table]:text-sm [&_th]:border-b [&_th]:border-gray-200 dark:[&_th]:border-gray-700 [&_th]:bg-gray-50 dark:[&_th]:bg-gray-850 [&_th]:p-3 [&_th]:text-left [&_th]:font-semibold dark:[&_th]:text-white [&_td]:border-b [&_td]:border-gray-100 dark:[&_td]:border-gray-800 [&_td]:p-3 [&_pre]:bg-gray-900 [&_pre]:text-emerald-400 [&_pre]:p-4 [&_pre]:rounded-xl [&_pre]:overflow-x-auto [&_pre]:font-mono [&_pre]:text-xs [&_code]:font-mono [&_code]:text-indigo-600 dark:[&_code]:text-cyan-400 [&_code]:bg-indigo-50 dark:[&_code]:bg-gray-800 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded">
      <Content />
    </article>

    <!-- Bottom Conversion CTA -->
    <div class="mt-16 rounded-2xl bg-indigo-50 dark:bg-gray-900 border border-indigo-100 dark:border-gray-800 p-8 sm:p-10 text-center">
      <span class="text-xs font-bold uppercase tracking-wider text-indigo-700 dark:text-cyan-400 bg-white dark:bg-gray-800 px-3 py-1 rounded-full shadow-sm">Try FlowForm Today</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 dark:text-white mt-4 mb-3">Own your form workflows for $0 platform fees</h2>
      <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 max-w-xl mx-auto mb-6">
        Whether you need a simple Mode 1 headless HTML form endpoint or a full Mode 2 dynamic multi-step wizard, FlowForm gives you full data sovereignty and zero per-submission taxes.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="https://docs.flowformhq.com" class="w-full sm:w-auto rounded-lg bg-indigo-600 dark:bg-cyan-500 text-white dark:text-gray-950 px-6 py-3 text-sm font-semibold hover:bg-indigo-700 dark:hover:bg-cyan-400 shadow-sm transition">
          Read Documentation
        </a>
        <a href="https://demo.flowformhq.com" target="_blank" class="w-full sm:w-auto rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-850 px-6 py-3 text-sm font-semibold text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800 shadow-sm transition">
          Try Live Sandbox
        </a>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="border-t border-gray-100 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 py-12 mt-20">
    <div class="max-w-6xl mx-auto px-6 text-center text-sm text-gray-500 dark:text-gray-400">
      <p>&copy; 2026 FlowFormHQ. Dual-licensed under AGPLv3 and Commercial Terms.</p>
    </div>
  </footer>

  <script src="../../main.js"></script>
</body>
</html>
