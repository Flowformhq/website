---
import '../../style.css';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Engineering Blog & Comparisons — FlowForm</title>
  <meta name="description" content="Technical breakdowns, benchmark comparisons against Formspree, Web3Forms, Typeform, and tutorials on self-hosted form engineering and data sovereignty." />
  <link rel="canonical" href="https://flowformhq.com/blog/" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Engineering Blog & Comparisons — FlowForm" />
  <meta property="og:description" content="Technical breakdowns, benchmark comparisons against Formspree, Web3Forms, Typeform, and tutorials on self-hosted form engineering." />
  <meta property="og:url" content="https://flowformhq.com/blog/" />
  <meta property="og:image" content="https://flowformhq.com/og.png" />
</head>
<body class="bg-white text-gray-900 antialiased font-sans flex flex-col min-h-screen">

  <!-- Nav -->
  <header class="border-b border-gray-100 bg-white/80 backdrop-blur-md sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 font-bold text-xl tracking-tight text-gray-900">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600 text-white font-mono text-base font-bold shadow-sm">F</span>
        FlowForm
      </a>

      <div class="flex items-center gap-6 text-sm font-medium">
        <a href="/" class="text-gray-600 hover:text-gray-900">Home</a>
        <a href="/blog" class="text-indigo-600 font-semibold">Blog</a>
        <a href="https://docs.flowformhq.com" class="text-gray-600 hover:text-gray-900">Docs</a>
        <a href="https://demo.flowformhq.com" target="_blank" class="rounded-md bg-indigo-600 text-white px-3 py-1.5 font-medium hover:bg-indigo-700 transition">
          Live Demo
        </a>
      </div>
    </div>
  </header>

  <!-- Main Hero -->
  <main class="flex-1 max-w-5xl mx-auto px-6 py-16">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-indigo-700 bg-indigo-50 border border-indigo-100 px-3 py-1 rounded-full">Engineering Blog</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-gray-900 mt-4 mb-4">
        Form Architecture, Comparisons &amp; Privacy
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed">
        Deep dives into form engineering, head-to-head comparisons against proprietary form SaaS, and guides for building sovereign workflows with $0 platform taxes.
      </p>
    </div>

    <!-- Posts Grid -->
    <div class="grid md:grid-cols-2 gap-8">
      {posts.map((post) => (
        <article class="flex flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-sm hover:shadow-md transition">
          <div class="flex items-center justify-between gap-2 text-xs text-gray-500 mb-3">
            <span class="font-semibold text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded-md">{post.data.category}</span>
            <time datetime={post.data.publishDate}>{new Date(post.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
          </div>
          
          <h2 class="text-xl font-bold text-gray-900 mb-3 leading-snug hover:text-indigo-600 transition">
            <a href={`/blog/${post.id}`}>
              {post.data.title}
            </a>
          </h2>

          <p class="text-sm text-gray-600 leading-relaxed line-clamp-3 mb-6 flex-1">
            {post.data.description}
          </p>

          <div class="border-t border-gray-100 pt-4 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="h-6 w-6 rounded-full bg-gray-100 flex items-center justify-center text-xs font-mono text-gray-700">✍️</span>
              <span class="text-xs font-medium text-gray-700">{post.data.author}</span>
            </div>
            <a href={`/blog/${post.id}`} class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 flex items-center gap-1">
              Read article &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>

  <!-- Footer -->
  <footer class="border-t border-gray-100 bg-gray-50 py-12 mt-20">
    <div class="max-w-6xl mx-auto px-6 text-center text-sm text-gray-500">
      <p>&copy; 2026 FlowFormHQ. Dual-licensed under AGPLv3 and Commercial Terms.</p>
    </div>
  </footer>
</body>
</html>
