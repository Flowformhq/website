---
import '../../style.css';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Engineering Blog & Comparisons — FlowForm</title>
  <meta name="description" content="Technical breakdowns, benchmark comparisons against Formspree, Web3Forms, Typeform, and tutorials on self-hosted form engineering and data sovereignty." />
  <link rel="canonical" href="https://flowformhq.com/blog/" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- Theme detection script (Zero FOUT) -->
  <script is:inline>
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Engineering Blog & Comparisons — FlowForm" />
  <meta property="og:description" content="Technical breakdowns, benchmark comparisons against Formspree, Web3Forms, Typeform, and tutorials on self-hosted form engineering." />
  <meta property="og:url" content="https://flowformhq.com/blog/" />
  <meta property="og:image" content="https://flowformhq.com/og.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;600;700;800&family=Google+Sans+Text:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="bg-white dark:bg-[#0B0F19] text-gray-900 dark:text-gray-100 antialiased font-sans flex flex-col min-h-screen transition-colors duration-200">

  <!-- Nav -->
  <header class="border-b border-gray-100 dark:border-gray-800 bg-white/80 dark:bg-[#0B0F19]/80 backdrop-blur-md sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <img src="/brand/flowform-logo-light.svg" alt="FlowForm" class="h-8 w-auto dark:hidden" />
        <img src="/brand/flowform-logo-dark.svg" alt="FlowForm" class="h-8 w-auto hidden dark:block" />
      </a>

      <div class="flex items-center gap-6 text-sm font-medium">
        <a href="/" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Home</a>
        <a href="/blog" class="text-indigo-600 dark:text-cyan-400 font-semibold">Blog</a>
        <a href="https://docs.flowformhq.com" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Docs</a>
        <a href="https://demo.flowformhq.com" target="_blank" class="rounded-md bg-indigo-600 dark:bg-cyan-500 text-white dark:text-gray-950 px-3 py-1.5 font-semibold hover:bg-indigo-700 dark:hover:bg-cyan-400 transition">
          Live Demo
        </a>

        <!-- Dark/Light Theme Toggle -->
        <button type="button" aria-label="Toggle dark mode"
          class="theme-toggle-btn rounded-md border border-gray-300 dark:border-gray-700 p-2 text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition">
          <svg class="h-4 w-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="h-4 w-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Hero -->
  <main class="flex-1 max-w-5xl mx-auto px-6 py-16">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-indigo-700 dark:text-cyan-400 bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-100 dark:border-indigo-800 px-3 py-1 rounded-full">Engineering Blog</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-gray-900 dark:text-white mt-4 mb-4">
        Form Architecture, Comparisons &amp; Privacy
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
        Deep dives into form engineering, head-to-head comparisons against proprietary form SaaS, and guides for building sovereign workflows with $0 platform taxes.
      </p>
    </div>

    <!-- Posts Grid -->
    <div class="grid md:grid-cols-2 gap-8">
      {posts.map((post) => (
        <article class="flex flex-col rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-sm hover:shadow-md transition">
          <div class="flex items-center justify-between gap-2 text-xs text-gray-500 dark:text-gray-400 mb-3">
            <span class="font-semibold text-indigo-600 dark:text-cyan-400 bg-indigo-50 dark:bg-indigo-950/60 px-2.5 py-0.5 rounded-md">{post.data.category}</span>
            <time datetime={post.data.publishDate}>{new Date(post.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
          </div>
          
          <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-3 leading-snug hover:text-indigo-600 dark:hover:text-cyan-400 transition">
            <a href={`/blog/${post.id}`}>
              {post.data.title}
            </a>
          </h2>

          <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed line-clamp-3 mb-6 flex-1">
            {post.data.description}
          </p>

          <div class="border-t border-gray-100 dark:border-gray-800 pt-4 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="h-6 w-6 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-xs font-mono text-gray-700 dark:text-gray-300">✍️</span>
              <span class="text-xs font-medium text-gray-700 dark:text-gray-300">{post.data.author}</span>
            </div>
            <a href={`/blog/${post.id}`} class="text-xs font-semibold text-indigo-600 dark:text-cyan-400 hover:text-indigo-800 dark:hover:text-cyan-300 flex items-center gap-1">
              Read article &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>

  <!-- Footer -->
  <footer class="border-t border-gray-100 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 py-12 mt-20">
    <div class="max-w-6xl mx-auto px-6 text-center text-sm text-gray-500 dark:text-gray-400">
      <p>&copy; 2026 FlowFormHQ. Dual-licensed under AGPLv3 and Commercial Terms.</p>
    </div>
  </footer>

  <script src="../../main.js"></script>
</body>
</html>
